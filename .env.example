COMPOSE_PROJECT_NAME=enactus_os_next_dev
WEB_PORT=8002

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=

# Account links default to http://127.0.0.1:${WEB_PORT}.
# ACCOUNT_PUBLIC_ORIGIN=
# ACCOUNT_TRUSTED_PROXY_NETWORKS=

# Leave SMTP_HOST empty for local file delivery (or disabled production mail).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=
# SMTP_USE_SSL=
# SMTP_FROM_EMAIL=
# SMTP_TIMEOUT=

POSTGRES_DB=enactus_os_next
POSTGRES_USER=enactus_os_next_dev
POSTGRES_PASSWORD=

# Production uses a separate .env.production. See docs/OPERATIONS.md.
# DJANGO_PUBLIC_HOST=
# ENACTUS_PROD_SECRET_KEY=
# ENACTUS_PROD_POSTGRES_PASSWORD=
# PRODUCTION_WEB_PORT=8004
